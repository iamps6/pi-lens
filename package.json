{
  "name": "pi-lens",
  "version": "0.2.0",
  "description": "The terminal previewer for pi — tabbed side drawer for markdown, syntax-highlighted code, images, and PDFs (text + visual pages).",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "terminal",
    "preview",
    "markdown",
    "pdf",
    "image",
    "tui"
  ],
  "license": "MIT",
  "author": "iamps6",
  "homepage": "https://github.com/iamps6/pi-lens",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamps6/pi-lens.git"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^22",
    "jiti": "^2.7.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.8"
  }
}
